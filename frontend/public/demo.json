    {"id": 1, "type": "service", "date": "2025-02-02T09:00:00", "actor": "Mira", "action": "phone_call"},
    {"id": 2, "type": "message", "date": "2025-02-03T08:14:00", "from": "Mira", "from_id": "user1", "text": "Morning! How did the presentation go?"},
    {"id": 3, "type": "message", "date": "2025-02-03T08:22:00", "from": "Alex", "from_id": "user2", "text": "I survived 😄 Your good luck message worked"},
    {"id": 4, "type": "message", "date": "2025-02-03T08:24:00", "from": "Mira", "from_id": "user1", "text": ["Obviously. I have ", {"type": "bold", "text": "excellent"}, " luck"]},
    {"id": 5, "type": "message", "date": "2025-02-03T08:31:00", "from": "Alex", "from_id": "user2", "text": "And excellent timing"},
    {"id": 6, "type": "message", "date": "2025-02-03T08:35:00", "from": "Mira", "from_id": "user1", "text": "Careful, that almost sounded like a compliment 😉"},
    {"id": 7, "type": "message", "date": "2025-02-03T08:39:00", "from": "Alex", "from_id": "user2", "text": "Almost? I'll have to try harder next time"},
    {"id": 8, "type": "message", "date": "2025-02-04T18:10:00", "from": "Alex", "from_id": "user2", "text": "Coffee after work tomorrow?"},
    {"id": 9, "type": "message", "date": "2025-02-04T18:18:00", "from": "Mira", "from_id": "user1", "text": "Is this a serious coffee invitation?"},
    {"id": 10, "type": "message", "date": "2025-02-04T18:21:00", "from": "Alex", "from_id": "user2", "text": "Very serious. Best coffee, better company."},
    {"id": 11, "type": "message", "date": "2025-02-04T18:25:00", "from": "Mira", "from_id": "user1", "text": "Then yes. 6?"},
    {"id": 12, "type": "message", "date": "2025-02-05T12:03:00", "from": "Mira", "from_id": "user1", "text": "Don't forget our very serious coffee"},
    {"id": 13, "type": "message", "date": "2025-02-05T12:07:00", "from": "Alex", "from_id": "user2", "text": "Impossible. I've been looking forward to seeing you all day"},
    {"id": 14, "type": "message", "date": "2025-02-05T12:14:00", "from": "Mira", "from_id": "user1", "text": "Smooth. See you at six 😊"},
    {"id": 15, "type": "message", "date": "2025-02-06T09:02:00", "from": "Alex", "from_id": "user2", "text": "Last night was fun"},
    {"id": 16, "type": "message", "date": "2025-02-06T09:11:00", "from": "Mira", "from_id": "user1", "text": "It was. You are dangerously easy to talk to"},
    {"id": 17, "type": "message", "date": "2025-02-06T09:16:00", "from": "Alex", "from_id": "user2", "text": "Dangerously? Should I apologize?"},
    {"id": 18, "type": "message", "date": "2025-02-06T09:20:00", "from": "Mira", "from_id": "user1", "text": "Absolutely not"},
    {"id": 19, "type": "message", "date": "2025-02-08T14:00:00", "from": "Mira", "from_id": "user1", "text": "Found that book you mentioned"},
    {"id": 20, "type": "message", "date": "2025-02-08T14:12:00", "from": "Alex", "from_id": "user2", "text": "You remembered! Let me know what you think"},
    {"id": 21, "type": "message", "date": "2025-02-08T14:15:00", "from": "Mira", "from_id": "user1", "text": "Maybe you can explain the difficult parts over dinner"},
    {"id": 22, "type": "message", "date": "2025-02-08T14:19:00", "from": "Alex", "from_id": "user2", "text": "I'd love that. Though I might get distracted by you"},
    {"id": 23, "type": "message", "date": "2025-02-10T20:41:00", "from": "Alex", "from_id": "user2", "text": "How was your day?"},
    {"id": 24, "type": "message", "date": "2025-02-10T20:46:00", "from": "Mira", "from_id": "user1", "text": "Long. Better now that you're here"},
    {"id": 25, "type": "message", "date": "2025-02-10T20:50:00", "from": "Alex", "from_id": "user2", "text": "I like being the better part of your day"},
    {"id": 26, "type": "message", "date": "2025-02-10T20:58:00", "from": "Mira", "from_id": "user1", "text": "You're getting very confident"},
    {"id": 27, "type": "message", "date": "2025-02-10T21:01:00", "from": "Alex", "from_id": "user2", "text": "Only because you keep smiling at me"},
    {"id": 28, "type": "message", "date": "2025-02-12T07:45:00", "from": "Mira", "from_id": "user1", "text": "Доброе утро, sleepyhead"},
    {"id": 29, "type": "message", "date": "2025-02-12T07:51:00", "from": "Alex", "from_id": "user2", "text": "Morning, beautiful. Coffee later?"},
    {"id": 30, "type": "message", "date": "2025-02-12T07:54:00", "from": "Mira", "from_id": "user1", "text": "You know I can't say no to you and coffee"},
    {"id": 31, "type": "message", "date": "2025-02-14T17:30:00", "from": "Alex", "from_id": "user2", "text": "I have a small surprise for you"},
    {"id": 32, "type": "message", "date": "2025-02-14T17:33:00", "from": "Mira", "from_id": "user1", "text": "Should I be worried?"},
    {"id": 33, "type": "message", "date": "2025-02-14T17:35:00", "from": "Alex", "from_id": "user2", "text": "Only if flowers and dinner are frightening"},
    {"id": 34, "type": "message", "date": "2025-02-14T17:39:00", "from": "Mira", "from_id": "user1", "text": "That sounds suspiciously like a date"},
    {"id": 35, "type": "message", "date": "2025-02-14T17:42:00", "from": "Alex", "from_id": "user2", "text": "I was hoping you'd call it that"},
    {"id": 36, "type": "message", "date": "2025-02-14T17:46:00", "from": "Mira", "from_id": "user1", "text": "Then pick me up at seven ❤️"},
    {"id": 37, "type": "message", "date": "2025-02-15T10:02:00", "from": "Mira", "from_id": "user1", "text": "Still thinking about last night"},
    {"id": 38, "type": "message", "date": "2025-02-15T10:05:00", "from": "Alex", "from_id": "user2", "text": "Me too. Especially your smile"},
    {"id": 39, "type": "message", "date": "2025-02-15T10:08:00", "from": "Mira", "from_id": "user1", "text": "When do I get to see you again?"},
    {"id": 40, "type": "message", "date": "2025-02-15T10:12:00", "from": "Alex", "from_id": "user2", "text": "Tonight, if I get a vote"},
    {"id": 41, "type": "message", "date": "2025-02-15T10:16:00", "from": "Mira", "from_id": "user1", "text": "It's unanimous then"},
    {"id": 42, "type": "message", "date": "2025-02-15T10:18:00", "from": "Alex", "from_id": "user2", "text": "Can't wait to see you"},
    {"id": 43, "type": "message", "date": "2025-02-15T10:19:00", "from": "Mira", "from_id": "user1", "text": "Сені көруге мен де асықпын"},
    {"id": 44, "type": "message", "date": "2025-02-15T10:20:00", "from": "Alex", "from_id": "user2", "text": "You always know how to make me smile"},
    {"id": 45, "type": "message", "date": "2025-02-15T10:22:00", "from": "Mira", "from_id": "user1", "text": "Good. Keep that smile for me"},
    {"id": 46, "type": "message", "date": "2025-02-15T10:25:00", "from": "Alex", "from_id": "user2", "text": "Deal 😉"},
    {"id": 47, "type": "message", "date": "2025-02-15T10:26:00", "from": "Mira", "from_id": "user1", "text": "See you tonight"},
    {"id": 48, "type": "message", "date": "2025-02-15T10:27:00", "from": "Alex", "from_id": "user2", "text": "Seven can't come soon enough"}
  ]
